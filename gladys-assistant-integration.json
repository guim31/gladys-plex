{
  "manifest_version": 1,
  "type": "device",
  "name": "Plex",
  "description": {
    "en": "Control your Plex players: playback, now playing, activity and library sensors.",
    "fr": "Contrôlez vos lecteurs Plex : lecture, en cours, activité et bibliothèques.",
    "de": "Steuere deine Plex-Player: Wiedergabe, aktuelle Medien, Aktivität und Bibliotheken.",
    "es": "Controle sus reproductores Plex: reproducción, en curso, actividad y bibliotecas."
  },
  "version": "1.3.0",
  "docker_image": "ghcr.io/guim31/gladys-plex:1.3.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-plex/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "music": {
    "browse": true,
    "search": true,
    "queue": true,
    "append": true
  },
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect to your Plex Media Server",
        "fr": "Connexion à votre serveur Plex",
        "de": "Verbindung zu deinem Plex Media Server",
        "es": "Conexión a su Plex Media Server"
      },
      "description": {
        "en": "Enter the local address of your Plex Media Server (for example http://192.168.1.20:32400) and a Plex authentication token (X-Plex-Token). The linked article explains how to find your token from the Plex web app.",
        "fr": "Indiquez l'adresse locale de votre serveur Plex (par exemple http://192.168.1.20:32400) et un jeton d'authentification Plex (X-Plex-Token). L'article en lien explique comment trouver votre jeton depuis l'application web Plex.",
        "de": "Gib die lokale Adresse deines Plex Media Servers (zum Beispiel http://192.168.1.20:32400) und ein Plex-Authentifizierungstoken (X-Plex-Token) ein. Der verlinkte Artikel erklärt, wie du dein Token in der Plex-Web-App findest.",
        "es": "Introduzca la dirección local de su Plex Media Server (por ejemplo http://192.168.1.20:32400) y un token de autenticación de Plex (X-Plex-Token). El artículo enlazado explica cómo encontrar su token desde la aplicación web de Plex."
      },
      "links": [
        {
          "url": "https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/",
          "label": {
            "en": "How to find your Plex token",
            "fr": "Trouver votre jeton Plex",
            "de": "So findest du dein Plex-Token",
            "es": "Cómo encontrar su token de Plex"
          }
        }
      ]
    },
    {
      "key": "plex_url",
      "type": "string",
      "label": {
        "en": "Plex server URL",
        "fr": "URL du serveur Plex",
        "de": "URL des Plex-Servers",
        "es": "URL del servidor Plex"
      },
      "description": {
        "en": "Base URL of the Plex Media Server, including the port (32400 by default).",
        "fr": "URL de base du serveur Plex, port inclus (32400 par défaut).",
        "de": "Basis-URL des Plex Media Servers, inklusive Port (standardmäßig 32400).",
        "es": "URL base del Plex Media Server, con el puerto incluido (32400 por defecto)."
      },
      "placeholder": {
        "en": "http://192.168.1.20:32400",
        "fr": "http://192.168.1.20:32400",
        "de": "http://192.168.1.20:32400",
        "es": "http://192.168.1.20:32400"
      },
      "required": true
    },
    {
      "key": "plex_token",
      "type": "secret",
      "label": {
        "en": "Plex token (X-Plex-Token)",
        "fr": "Jeton Plex (X-Plex-Token)",
        "de": "Plex-Token (X-Plex-Token)",
        "es": "Token de Plex (X-Plex-Token)"
      },
      "required": true
    },
    {
      "key": "session_poll_frequency",
      "type": "number",
      "label": {
        "en": "Playback refresh interval (s)",
        "fr": "Rafraîchissement de la lecture (s)",
        "de": "Aktualisierung der Wiedergabe (s)",
        "es": "Actualización de la reproducción (s)"
      },
      "description": {
        "en": "How often active playback sessions are refreshed, in seconds. Real-time notifications from the server speed this up when something starts, pauses or stops.",
        "fr": "Fréquence de rafraîchissement des lectures en cours, en secondes. Les notifications temps réel du serveur accélèrent la mise à jour quand une lecture démarre, se met en pause ou s'arrête.",
        "de": "Wie oft laufende Wiedergaben aktualisiert werden, in Sekunden. Echtzeit-Benachrichtigungen des Servers beschleunigen die Aktualisierung, wenn eine Wiedergabe startet, pausiert oder stoppt.",
        "es": "Frecuencia de actualización de las reproducciones en curso, en segundos. Las notificaciones en tiempo real del servidor aceleran la actualización cuando una reproducción empieza, se pausa o se detiene."
      },
      "required": false,
      "default": 10,
      "min": 5,
      "max": 120
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Library refresh interval (s)",
        "fr": "Rafraîchissement des bibliothèques (s)",
        "de": "Aktualisierung der Bibliotheken (s)",
        "es": "Actualización de las bibliotecas (s)"
      },
      "description": {
        "en": "How often library statistics (item counts) are refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement des statistiques des bibliothèques (nombre d'éléments), en secondes.",
        "de": "Wie oft die Statistiken der Bibliotheken (Anzahl der Elemente) aktualisiert werden, in Sekunden.",
        "es": "Frecuencia de actualización de las estadísticas de las bibliotecas (número de elementos), en segundos."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "library_sensors",
      "type": "boolean",
      "label": {
        "en": "Library sensors",
        "fr": "Capteurs de bibliothèques",
        "de": "Bibliotheks-Sensoren",
        "es": "Sensores de bibliotecas"
      },
      "description": {
        "en": "Add one item-count sensor per Plex library on the server device (plus episodes for TV shows and tracks for music).",
        "fr": "Ajoute un capteur de compte d'éléments par bibliothèque Plex sur l'appareil serveur (plus les épisodes pour les séries et les pistes pour la musique).",
        "de": "Fügt dem Server-Gerät pro Plex-Bibliothek einen Sensor für die Anzahl der Elemente hinzu (plus Episoden bei Serien und Titel bei Musik).",
        "es": "Añade un sensor de número de elementos por biblioteca de Plex al dispositivo servidor (más los episodios para las series y las pistas para la música)."
      },
      "required": false,
      "default": true
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "Only for https URLs: accept the self-signed certificate of the Plex server. Leave off for http URLs.",
        "fr": "Uniquement pour les URL https : accepte le certificat auto-signé du serveur Plex. Laissez désactivé pour les URL http.",
        "de": "Nur für https-URLs: akzeptiert das selbstsignierte Zertifikat des Plex-Servers. Bei http-URLs deaktiviert lassen.",
        "es": "Solo para URL https: acepta el certificado autofirmado del servidor Plex. Déjelo desactivado para las URL http."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the music panel",
        "fr": "Langue du panneau Musique",
        "de": "Sprache des Musik-Panels",
        "es": "Idioma del panel Música"
      },
      "description": {
        "en": "Language of the folders of the Music widget (Gladys 5.3) and of the messages its commands return.",
        "fr": "Langue des dossiers du widget Musique (Gladys 5.3) et des messages renvoyés par ses commandes.",
        "de": "Sprache der Ordner des Musik-Widgets (Gladys 5.3) und der Meldungen seiner Befehle.",
        "es": "Idioma de las carpetas del widget Música (Gladys 5.3) y de los mensajes que devuelven sus comandos."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the Plex connection",
        "fr": "Tester la connexion Plex",
        "de": "Plex-Verbindung testen",
        "es": "Probar la conexión con Plex"
