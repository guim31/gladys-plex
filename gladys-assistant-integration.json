      "timeout_seconds": 30
    },
    {
      "key": "scan_clients",
      "label": {
        "en": "Scan for Plex players",
        "fr": "Rechercher les lecteurs Plex",
        "de": "Nach Plex-Playern suchen",
        "es": "Buscar reproductores Plex"
      },
      "timeout_seconds": 30
    }
